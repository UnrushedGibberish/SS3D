root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = tab
indent_size = tab

# Use Allman-style braces for all constructs (Roslyn consolidated key)
# See: csharp_new_line_before_open_brace = all
csharp_new_line_before_open_brace = all

# Prefer braces and disallow single-line embedded statements
csharp_prefer_braces = true:warning
csharp_style_allow_embedded_statements_on_same_line = false:warning

# Treat these as editor suggestions
dotnet_diagnostic.IDE0051.severity = none

# IDE0074: Use compound assignment
dotnet_diagnostic.IDE0074.severity = none

# IDE1006: Naming Styles
dotnet_diagnostic.IDE1006.severity = warning
